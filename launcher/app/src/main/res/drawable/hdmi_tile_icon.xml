<?xml version="1.0" encoding="utf-8"?>
<!-- The HDMI quick-switch tile's icon (config.xml hdmi_tiles): a plug in a faint disc, with a green dot
     at the disc's edge for "a device is plugged in". The disc sits 2dp inside the view so the dot can
     straddle its edge instead of covering the plug. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="oval">
            <solid android:color="#24FFFFFF" />
        </shape>
    </item>
    <!-- Nudged up and left so the dot does not sit on the plug. -->
    <item android:drawable="@drawable/ic_input" android:gravity="center" android:width="15dp" android:height="15dp"
        android:right="5dp" android:bottom="5dp" />
    <item android:gravity="bottom|end" android:width="10dp" android:height="10dp">
        <shape android:shape="oval">
            <solid android:color="#FF4CD964" />
            <stroke android:width="2dp" android:color="#FF0A0A0A" />
        </shape>
    </item>
</layer-list>
