<?xml version="1.0" encoding="utf-8"?>
<!-- Capsule tiles (tile_style capsule): a hairline at rest, glass fill and a bright rim with focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#42FFFFFF" android:endColor="#1FFFFFFF" />
            <stroke android:width="2dp" android:color="#E6FFFFFF" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#59FFFFFF" />
            <corners android:radius="30dp" />
        </shape>
    </item>
</selector>
