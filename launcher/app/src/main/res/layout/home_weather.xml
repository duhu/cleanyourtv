<?xml version="1.0" encoding="utf-8"?>
<!-- The home screen's weather (HomeWeatherView, config.xml home_weather): a band with the current
     conditions and the next hours, then a row of day cards. Mockup: designs/home-tiles/G2 天气横条.html. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/wxBand"
        android:layout_width="match_parent"
        android:layout_height="115dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:background="@drawable/standby_bar">

        <ImageView
            android:id="@+id/wxNowIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/wxNowTemp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:textColor="#FFFFFFFF"
            android:textSize="60sp"
            android:fontFamily="@font/outfit_extralight"
            android:letterSpacing="-0.04"
            android:includeFontPadding="false" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/wxNowCond"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#E6FFFFFF"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/wxNowHiLo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#8CFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <View
            android:id="@+id/wxDivider"
            android:layout_width="1dp"
            android:layout_height="75dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="10dp"
            android:background="#40FFFFFF" />

        <LinearLayout
            android:id="@+id/wxHours"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/wxDays"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="15dp"
        android:orientation="horizontal" />
</merge>
