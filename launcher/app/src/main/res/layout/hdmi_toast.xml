<?xml version="1.0" encoding="utf-8"?>
<!-- HDMI toast (HdmiToastView): "HDMI 2 detected, switching…" with a 1.5 s progress line, centred over everything. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:id="@+id/toastPanel"
        android:layout_width="410dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="28dp"
        android:background="@drawable/glass_panel"
        android:alpha="0">

        <TextView
            android:id="@+id/toastBadge"
            android:layout_width="55dp"
            android:layout_height="55dp"
            android:gravity="center"
            android:background="@drawable/hdmi_badge"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:fontFamily="@font/outfit_medium"
            android:letterSpacing="0.06" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="20dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/toastTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFFFF"
                android:textSize="21sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/standby_hdmi_unplug"
                android:textColor="#8CFFFFFF"
                android:textSize="13sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="13dp"
                android:background="#1FFFFFFF">

                <View
                    android:id="@+id/toastProgress"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="#E6FFFFFF"
                    android:scaleX="0" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</merge>
