<?xml version="1.0" encoding="utf-8"?>
<!-- The status bar the standby screen and the home screen share: the HDMI hint, then one cell per CI
     project added by StatusCells.fill. Included as standbyBar (standby.xml) and homeBar (activity_main.xml). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/statusBar"
    android:layout_width="match_parent"
    android:layout_height="55dp"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/standby_bar">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="14dp">

        <TextView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:gravity="center"
            android:background="@drawable/hdmi_badge"
            android:text="@string/standby_hdmi_badge"
            android:textColor="#8CFFFFFF"
            android:textSize="7sp"
            android:fontFamily="@font/outfit_medium"
            android:letterSpacing="0.05" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="9dp"
            android:text="@string/standby_hdmi_hint"
            android:textColor="#E6FFFFFF"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
