<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Or leave it and push a theme instead: tools/theme.sh themes/<name> puts a config.json (same keys, see
  themes/README.md) and an optional wallpaper on the TV, and the launcher overlays it at start.
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').
-->
<resources>

    <!-- Apps pinned to the dock row at the bottom, in this order. Missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>com.xiaomi.mitv.tvplayer</item>
        <item>com.xiaomi.mitv.appstore</item>
        <item>com.xiaomi.mitv.smartshare</item>
        <item>com.xiaomi.mitv.mediaexplorer</item>
    </string-array>
    <!-- With fewer dock_apps than columns (or a dock app that is not installed), the free dock slots take
         the first grid apps, so the dock never shows a gap. false leaves them empty (#162); a theme can
         set "fill_dock": false. -->
    <bool name="fill_dock">true</bool>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs menu already covers). -->
    <string-array name="hidden_apps">
        <item>com.mitv.tvhome</item>
        <item>com.mitv.gallery</item>
    </string-array>

    <!-- When not empty, only these packages get tiles (hidden_apps still applies). For a TV used for one
         thing, e.g. a meeting-room set that only casts. Leave empty to show every app. -->
    <string-array name="only_apps" />

    <!-- The greeting line above the clock ("Good evening"); false hides it. -->
    <bool name="show_greeting">true</bool>
    <!-- Tiles as "card" (banner or icon on a dark card, the name under it) or "capsule" (a round icon and the
         name in one pill, like the top-right buttons; no glass highlight and no large title). -->
    <string name="tile_style" translatable="false">card</string>
    <!-- Keep the Inputs, network and Settings buttons faint until one of them has focus. -->
    <bool name="dim_top_buttons">false</bool>

    <!-- Activities shown as tiles although they declare neither LEANBACK_LAUNCHER nor LAUNCHER, as
         package/activity. China-market Xiaomi firmware hides its app store, file explorer and TV player this
         way (com.xiaomi.mitv.appstore/.MainActivity). Must be exported; one tile per package. Leave empty to omit. -->
    <string-array name="extra_apps">
        <item>com.xiaomi.mitv.tvplayer/.ExternalSourceActivity</item>
        <item>com.xiaomi.mitv.appstore/.MainActivity</item>
        <item>com.xiaomi.mitv.mediaexplorer/.NewScraperMainEntryActivity</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit. -->
    <string name="live_tv_package" translatable="false">com.xiaomi.mitv.tvplayer</string>

    <!-- Some TVs give their Live TV app no leanback entry point at all, so `live_tv_package` above
         resolves to nothing (TCL Android TV 9 on China-market sets is one). This action is then sent
         to that package instead, and the app starts normally. Leave empty to omit. -->
    <string name="live_tv_action" translatable="false">com.xiaomi.mitv.tvplayer.ATV_PLAY</string>

    <!-- TVs with no TvInputManager have no HDMI list to read, but their own source-selection panel
         still switches inputs (TCL Android TV 9 again). When nothing could be listed, the Inputs menu
         offers one row that starts this service: component first, then action. Leave empty to omit. -->
    <string name="source_panel_service" translatable="false"></string>
    <string name="source_panel_action" translatable="false"></string>

    <!-- Inputs menu: HDMI and AV rows normally open with ACTION_VIEW on the input's channel URI, which the
         Live TV app handles. Where nothing answers that, this action is sent with the same URI instead
         (XGIMI projectors: com.xgimi.action.hdmiPlayer). Leave empty to omit. -->
    <string name="input_action" translatable="false">com.xiaomi.mitv.tvplayer.EXTSRC_PLAY</string>
    <!-- Players that take no channel URI at all but an integer extra naming the source: the extra's name, and
         the framework input id's last segment paired with that number. Xiaomi China-market firmware (Amlogic and
         MediaTek alike): HDMI1..3 = 23..25, AV = 2, sent as `input` to live_tv_package. Leave empty to omit. -->
    <string name="input_extra" translatable="false">input</string>
    <string name="input_map" translatable="false">HW5=23,HW6=24,HW7=25,HW1=2</string>

    <!-- Remote buttons that open Settings, by Linux scancode (HOME_KEY_SERVICE=1 build-and-install.sh). Remotes
         that send KEYCODE_SETTINGS need no entry. Some send a code Android does not map: the Xiaomi/Fengmi
         projector remote's gear button is scancode 384 (KEY_TAPE). Find yours with
         `tools/tv.py 'getevent -lt'` while pressing the button. Leave empty to omit. -->
    <integer-array name="settings_key_scancodes">
    </integer-array>
    <!-- The same by Android keycode, for buttons whose scancode is shared. TCL Google TV remotes send their
         Settings button as keycode 83 (KEYCODE_NOTIFICATION, which the stock Google TV home turned into its quick
         settings panel) on scancode 240 (KEY_UNKNOWN), the scancode several TCL buttons share. Find the keycode
         with `tools/tv.py 'logcat -v time -s InputReader:D'` while pressing the button. Leave empty to omit. -->
    <integer-array name="settings_key_keycodes">
    </integer-array>
    <!-- What those Settings buttons open: false, the TV's Settings; true, a small glass panel at the top right
         with TV settings, Display, Network, Apps (re-enable an app) and Launcher settings, over whatever is on screen.
         Both keys can also be set from a theme's config.json ("settings_key_keycodes": [83]). -->
    <bool name="settings_key_panel">false</bool>

    <!-- Show the Solar Hijri (Shamsi) date used in Iran and Afghanistan, e.g. "27 Mehr 1405", above the
         Gregorian date. -->
    <bool name="shamsi_date">false</bool>
    <!-- Optional VPN app the network pill opens (hold the pill for Wi-Fi settings), e.g. the package of the
         VPN you use. Empty: the pill opens Wi-Fi settings. The green VPN badge shows for any VPN either way;
         with an app set here, a red "VPN off" badge also shows while no VPN is up. -->
    <string name="vpn_app" translatable="false"></string>
    <!-- Grid rows left visible under the dock on the home screen. 0 = dock sits at the very bottom. -->
    <integer name="rows_below_dock">0</integer>

    <!-- Tiles per row in the grid; the dock always has this many slots. Tiles are 180dp wide at 4 columns and
         shrink to fit from 5 up (about 144dp at 5, 117dp at 6 on a 1080p TV). -->
    <integer name="columns">4</integer>

    <!-- Basic motion is on; advanced effects are opt-in in the launcher's own Settings screen. -->
    <bool name="animations">true</bool>
    <bool name="advanced_effects">false</bool>

    <!-- Optional Default-home tile; keep this key for existing themes and tile-ordering work.
         Off by default because the chooser is also available from launcher settings. -->
    <bool name="show_home_settings_shortcut">false</bool>

    <!-- Module cards: an app that declares a card (docs/specs/card.md) can stand in for its tile with its own
         label, caption and glow colour, once you answer Show on the prompt. false: never look for cards or ask. -->
    <bool name="module_cards">true</bool>

    <!-- Reduced motion: for TVs whose GPU cannot keep up (MediaTek MT5895 on Android 10 is the known case).
         true keeps the GPU drawing path but calms the movement: a stiff highlight spring with no bounce,
         tiles that zoom without overshoot, shorter fades and no tile entrance when Home comes back. Set it
         here or with "reduced_motion": true in a theme's config.json; false keeps the normal motion. -->
    <bool name="reduced_motion">false</bool>

    <!-- Time-of-day backdrop behind everything: a dark gradient that follows the clock, with a warm
         horizon glow around sunrise and sunset. 0 keeps the plain background (the default); 1 to 100
         sets its opacity. Around 60 reads clearly without hiding a wallpaper. Can also be set with
         "sky_intensity": 60 in a theme's config.json. -->
    <integer name="sky_intensity">0</integer>

    <!-- Meeting-room standby screen (docs/superpowers/specs/2026-10-20-meeting-room-standby-design.md).
         Off unless a theme turns it on: a clock, the date and weather, and a status bar with the latest
         CI pipeline of each GitLab project, shown after standby_idle_seconds without a key press. -->
    <bool name="standby">false</bool>
    <integer name="standby_idle_seconds">30</integer>
    <!-- The standby clock as split-flap cards that flip on every minute change; false shows plain digits. -->
    <bool name="standby_flip_clock">true</bool>
    <!-- Open-Meteo coordinates, decimal degrees as text; both empty keeps the weather off. -->
    <string name="weather_lat" translatable="false"></string>
    <string name="weather_lon" translatable="false"></string>
    <!-- Self-hosted GitLab: base URL, a read_api token, and group/project paths for the status bar. -->
    <string name="gitlab_url" translatable="false"></string>
    <string name="gitlab_token" translatable="false"></string>
    <string-array name="gitlab_projects" />
    <!-- One JSON with everything (see StandbyData.parseFeed); when set, the two sources above are not used. -->
    <string name="feed_url" translatable="false"></string>
    <!-- Plugging a device into an HDMI port switches to it; unplugging brings Home back. -->
    <bool name="hdmi_auto_switch">false</bool>
    <!-- A quick-switch tile in the dock row for every HDMI port with a device plugged in; focus lands on it. -->
    <bool name="hdmi_tiles">false</bool>
</resources>
